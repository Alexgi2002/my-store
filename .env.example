# App
NODE_ENV=production
NEXT_PUBLIC_URL=https://tu-dominio.com
HOST_PORT=3000

# Admin (OBLIGATORIO en producción)
ADMIN_PASSWORD=cambiar_por_una_contraseña_fuerte
ADMIN_JWT_SECRET=secreto_muy_largo_y_aleatorio
